# Required: at least 32 characters. Generate with `openssl rand -base64 32`.
TRAMLINE_SECRET_KEY=

# Optional: SQLite file location (default: data/tramline.db)
# TRAMLINE_DATABASE_PATH=data/tramline.db

# Optional: public URL of this install
# TRAMLINE_URL=http://localhost:5173

# Optional: GitHub sign-in
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
