# Required: at least 32 characters. Generate with `openssl rand -base64 32`.
TRAMLINE_SECRET_KEY=

# Optional: SQLite file location (default: data/tramline.db)
# TRAMLINE_DATABASE_PATH=data/tramline.db

# Optional: where logs and the local agent token live (default: data)
# TRAMLINE_DATA_DIR=data

# Optional: wildcard domain for generated service URLs (default: localhost, plain HTTP)
# TRAMLINE_BASE_DOMAIN=apps.example.com

# Optional: host port for the ingress proxy (default: 80)
# TRAMLINE_INGRESS_PORT=80

# Optional: public URL of this install. Required to connect GitHub; push webhooks are
# only requested when it is https and reachable from the internet, otherwise Tramline polls.
# TRAMLINE_URL=http://localhost:5173

# Optional: seconds between checks for new commits when GitHub can't send webhooks
# (default: 60; 0 disables polling; repositories without the GitHub App are checked every 5 minutes)
# TRAMLINE_GIT_POLL_SECONDS=60

# Optional: GitHub sign-in
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: encrypted snapshots of this install's own database to an S3-compatible bucket.
# Restore with `pnpm --filter @tramline/web restore-control-plane --yes` (Tramline stopped).
# TRAMLINE_BACKUP_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# TRAMLINE_BACKUP_S3_REGION=eu-west-1
# TRAMLINE_BACKUP_S3_BUCKET=
# TRAMLINE_BACKUP_S3_PREFIX=
# TRAMLINE_BACKUP_S3_ACCESS_KEY_ID=
# TRAMLINE_BACKUP_S3_SECRET_ACCESS_KEY=
# TRAMLINE_BACKUP_S3_PATH_STYLE=true
# TRAMLINE_BACKUP_INTERVAL_MINUTES=60
# TRAMLINE_BACKUP_KEEP=72
