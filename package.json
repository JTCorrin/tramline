{
	"name": "tramline",
	"private": true,
	"version": "0.0.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @tramline/web --filter @tramline/agent dev",
		"build": "pnpm --filter @tramline/web build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && pnpm -r lint",
		"format": "prettier --write .",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @tramline/web test:e2e",
		"test:coverage": "pnpm -r test:coverage"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.12",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
